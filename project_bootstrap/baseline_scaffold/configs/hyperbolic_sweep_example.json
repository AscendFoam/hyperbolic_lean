{
  "base_config": "hyperbolic_example.json",
  "output_root": "artifacts/baselines/hyperbolic_sweeps/low_dim_curvature_scan_v1",
  "shared_overrides": {
    "epochs": 40,
    "eval_every": 5,
    "early_stopping_patience": 4,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "grad_clip_norm": 1.0
  },
  "per_variant_overrides": {
    "poincare_gcn_v1": {
      "dropout": 0.2
    }
  },
  "model_variants": [
    "poincare_gcn_v1"
  ],
  "dimensions": [
    8,
    16,
    32
  ],
  "curvatures": [
    0.5,
    1.0,
    2.0
  ],
  "dim_mode": "tie_all",
  "sort_by": "val_average_precision",
  "run_name_template": "{variant}_dim{dim}_c{curvature}"
}
